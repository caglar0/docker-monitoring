@app.post("/receiver")
def receive_agent_logs(payload: dict, db: Session = Depends(get_db)):
    raw_log = payload.get("message", "")
    parsed_res = parse_log(raw_log)
    
    if parsed_res:
        db_event = AuditEvent(
            timestamp=parsed_res["timestamp"],
            status=parsed_res["status"],
            pid=parsed_res["pid"],            executable=parsed_res["executable"],
            operation=parsed_res["operation"],
            syscall=parsed_res["syscall"],
            command=parsed_res["command"],
        )
        
        db.add(db_event)
        db.commit() 
        db.refresh(db_event)

        print(f"[*] Log başarıyla DB'ye kaydedildi! ID: {db_event.id}")
        return Response(content="Log DB'ye kaydedildi\n", media_type="text/plain")

    return Response(
        content="Log atlandı (Docker değil)\n",
        media_type="text/plain",
        status_code=200,
    )

